{
  "version": 2,
  "buildCommand": "cd backend && python manage.py migrate --noinput && python manage.py create_admin_from_env --noinput",
  "builds": [
    {
      "src": "backend/little_fingers/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "frontend/static/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "frontend/static/robots.txt"
    },
    {
      "src": "/BingSiteAuth.xml",
      "dest": "frontend/static/BingSiteAuth.xml"
    },
    {
      "src": "/(.*)",
      "dest": "backend/little_fingers/wsgi.py"
    }
  ]
}
